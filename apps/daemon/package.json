{
  "name": "@relaycode/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "relaycode-daemon": "dist/apps/daemon/src/index.js"
  },
  "scripts": {
    "cli": "tsx src/index.ts",
    "dev": "tsx src/index.ts start",
    "configure": "tsx src/index.ts configure",
    "list": "tsx src/index.ts list",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/daemon/src/index.js start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@relaycode/shared": "*",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
