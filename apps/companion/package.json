{
  "name": "@relaycode/companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/apps/companion/src/main.js",
  "scripts": {
    "dev": "npm run build && node scripts/launch-dev.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package:mac": "npm run build && electron-builder --mac dmg zip",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@relaycode/shared": "*",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "electron": "38.8.6",
    "electron-builder": "25.1.8",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.relaycode.companion",
    "productName": "Relaycode Companion",
    "protocols": [
      {
        "name": "Relaycode Companion links",
        "schemes": ["relaycode"]
      }
    ],
    "asar": true,
    "directories": { "output": "release" },
    "extraResources": [
      { "from": "src/renderer", "to": "renderer" }
    ],
    "files": ["dist/**/*", "src/preload.cjs", "src/renderer/**/*", "package.json", "../../packages/shared/package.json"],
    "mac": { "category": "public.app-category.developer-tools", "target": ["dmg", "zip"] }
  }
}
