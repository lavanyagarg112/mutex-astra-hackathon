# Server
DATABASE_URL="postgresql://relaycode:relaycode@localhost:5432/relaycode?schema=public"
PORT=4100
WEB_ORIGIN=http://localhost:5173
PUBLIC_URL=http://localhost:4100
# GitHub App or OAuth App user authorization. Callback: http://localhost:4100/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4100/api/auth/github/callback
# Leave blank for a GitHub App. For a classic OAuth App use: read:user repo
GITHUB_OAUTH_SCOPE=
# Generate each with: openssl rand -base64 32
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
# Public GitHub Releases page containing all Companion installers
COMPANION_RELEASE_URL=
# Username-only login is for local demos and is always disabled in production unless explicitly enabled.
ALLOW_DEMO_AUTH=true
DEMO_REPOSITORY_URL=git@github.com:your-org/your-repository.git
DEMO_BRANCH=main

# Web
VITE_API_URL=http://localhost:4100
# Optional: set to alice/bob/charlie to bypass the username screen.
VITE_DEMO_USER_ID=

# Local companion (keep this only on the developer machine)
RELAYCODE_SERVER_URL=http://localhost:4100
RELAYCODE_USER_ID=alice
RELAYCODE_DAEMON_TOKEN=alice-daemon-token
# Configure the shared OpenAI key and model once in Project Settings.
# A custom command provider can still be stored with `relaycode-daemon configure`.
